---
import { Image } from 'astro:assets';
import brandMark from '../assets/brand-mark.webp';
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md">
  <div class="flex min-h-[74px] items-center gap-4 tablet:gap-8 mx-auto w-shell">
      <a class="shrink-0 [&>img]:h-8 [&>img]:w-8 [&>img]:object-contain tablet:[&>img]:h-11 tablet:[&>img]:w-11" href="#home" aria-label="Ilaria Mezzanotti, home">
        <Image src={brandMark} width={48} densities={[1, 2]} alt="" loading="eager" />
      </a>
      <nav class="ml-auto flex items-center gap-4 tablet:gap-[clamp(20px,3vw,40px)] [&>a]:py-3 [&>a]:text-[13px] [&>a]:font-medium tablet:[&>a]:text-[15px] [&>a:hover]:text-brand-green" aria-label="Navigazione principale">
        <a href="#dove-ricevo">Dove ricevo</a>
        <a href="#consulenze" class="hidden tablet:block">Consulenze</a>
        <a href="#contatti">Contatti</a>
      </nav>
  </div>
</header>
