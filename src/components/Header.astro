---

<div class="px-4 pt-6 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between sm:h-10 lg:justify-start" aria-label="Global">
    <div class="flex items-center flex-grow flex-shrink-0 lg:flex-grow-0">
      <div class="flex items-center w-full md:w-auto">
        <a title="home" href="#" class="pr-2 rounded-md">
          <img
            class="w-8 h-8 sm:h-8 dark:rounded-lg"
            title="Ilaria Mezzanotti"
            src="/assets/img/logo.webp"
            width="32"
            height="32"
            alt="Logo Dott.ssa Ilaria Mezzanotti, Psicologa e Psicoterapeuta"
          />
        </a>

        <a
          title="dove ricevo"
          href="#dove-ricevo"
          class="px-2 py-1 mr-3 text-sm font-semibold text-gray-500 transition ease-in-out rounded-md shadow-3xl dark:shadow-3xl hover:scale-110 delay-50 hover:text-black md:text-base dark:text-white"
          >Dove ricevo ?</a
        >
        <a
          title="contatti"
          href="#contatti"
          class="px-2 py-1 mr-3 text-sm font-semibold text-gray-500 transition ease-in-out rounded-md shadow-3xl dark:shadow-3xl hover:-translate-y-1 hover:scale-110 delay-50 hover:text-gray-900 md:text-base dark:text-white"
          >Contatti</a
        >
        <div class="flex items-center justify-end space-x-2">
          <div>
            <input type="checkbox" name="" id="toggle" aria-label="Attiva tema scuro" class="hidden" />
            <label for="toggle">
              <div class="flex items-center w-10 h-6 p-1 bg-gray-400 rounded-full cursor-pointer">
                <div class="w-5 h-5 duration-300 ease-in-out transform bg-white rounded-full shadow-xl toggle-dot">
                </div>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>
    <div class="hidden md:block md:ml-10 md:pr-4 md:space-x-8"></div>
  </div>
</div>
