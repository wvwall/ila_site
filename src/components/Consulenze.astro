---
const servizi = [
  { icon: "fa-seedling", label: "Supporto psicologico adulti e minori" },
  { icon: "fa-parachute-box", label: "Prevenzione" },
  { icon: "fa-hand-holding-heart", label: "Colloqui di coppia e individuali" },
  { icon: "fa-handshake-simple", label: "Gruppi terapeutici" },
  { icon: "fa-hands-holding-child", label: "Consulenze educative" },
  { icon: "fa-hand-holding-hand", label: "Gestione dello stress" },
  { icon: "fa-seedling", label: "Percorsi di crescita personale" },
];
---

<section
        id="consulenze"
        class="px-panel [&>h2]:mb-7 [&>h2]:text-brand-green tablet:[&>h2]:mb-10 mx-auto w-shell mt-section"
        aria-labelledby="consultations-title"
      >
        <h2 id="consultations-title" class="font-medium tracking-[-0.035em] [text-wrap:pretty] text-section-title leading-[1.15] data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>Consulenze</h2>
        <div class="grid grid-cols-1 items-start gap-10 desktop:grid-cols-[0.95fr_1.15fr] desktop:gap-[clamp(40px,6vw,88px)]">
          <div class="max-w-[48ch] text-base leading-[1.8] tablet:max-w-[65ch] tablet:text-lg tablet:leading-[1.85] desktop:max-w-[48ch] [&>p+p]:mt-6 [&_a]:underline [&_a]:decoration-brand-pink [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a:hover]:text-brand-green">
            <p class="data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>
              Mi chiamo Ilaria Mezzanotti, sono una Psicologa clinica abilitata e Psicoterapeuta,
              specializzata presso la
              <a href="https://www.scuolapsicoterapiagestalt.it/" target="_blank" rel="noopener noreferrer"
                >Scuola Gestalt di Torino</a
              >.
            </p>
            <p class="data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>
              Attualmente ricevo, su appuntamento, presso gli studi di Robassomero, Leinì e Cuorgnè o tramite
              consulenze online.
            </p>
          </div>
          <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 tablet:grid-cols-2 tablet:gap-x-10 desktop:gap-x-8 desktop:gap-y-7 [&>li]:flex [&>li]:items-start [&>li]:gap-3.5 [&>li]:text-base [&>li]:leading-[1.6] [&_i]:w-[26px] [&_i]:shrink-0 [&_i]:pt-[3px] [&_i]:text-center [&_i]:text-[22px] [&_i]:text-brand-green" aria-label="Ambiti di consulenza">
            {servizi.map((servizio) => (
              <li class="data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>
                <i class={`fa-solid ${servizio.icon}`} aria-hidden="true" />
                <span>{servizio.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
