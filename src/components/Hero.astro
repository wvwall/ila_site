---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
---

<section class="grid grid-cols-1 items-center gap-8 pb-12 pt-0 tablet:grid-cols-[1.15fr_1fr] tablet:gap-4 tablet:pb-[88px]  desktop:grid-cols-[1.12fr_1fr] desktop:gap-8 mx-auto w-shell" id="hero" aria-labelledby="hero-title">
        <div class="relative z-[1] px-1 tablet:px-0">
          <h1 id="hero-title" class="font-medium [text-wrap:pretty] text-hero-mobile leading-[1.12] tracking-[-0.045em] text-brand-green tablet:text-hero-tablet tablet:leading-[1.1] desktop:text-hero data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>Dott.ssa Ilaria<br />Mezzanotti</h1>
          <p class="mt-0 text-base leading-[1.6] tablet:text-profession data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>Psicologa e Psicoterapeuta</p>
          <p class="mt-6 max-w-[36ch] text-base leading-[1.7] tablet:mt-7 tablet:max-w-[38ch] tablet:text-lg tablet:leading-[1.7] data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal>
            Cum lenitate asperitas – Le difficoltà vanno trattate con dolcezza.
          </p>
          <a
            class="mt-6 inline-flex min-h-[54px] items-center justify-center gap-2.5 rounded-full bg-brand-pink px-5 py-[15px] text-sm font-medium leading-[1.6] text-white hover:-translate-y-0.5 hover:bg-brand-hover active:translate-y-0 active:scale-[0.98] tablet:mt-8 tablet:py-4 desktop:gap-4 desktop:px-6 desktop:text-base desktop:leading-[1.6] [&>i]:text-2xl [&>i]:leading-none data-[visible=true]:animate-settle motion-reduce:!animate-none" data-reveal
            href="https://wa.me/393663712597"
            target="_blank"
            rel="noopener noreferrer"
          >
            Richiedi un appuntamento <i class="fab fa-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
        <div class="mx-auto min-w-0 w-[min(100%,330px)] tablet:mx-0 tablet:w-auto [&>img]:h-auto [&>img]:w-full [&>img]:object-contain data-[visible=true]:animate-settle-slow motion-reduce:!animate-none" data-reveal>
          <Image
            src={logo}
            width={1200}
            widths={[330, 550, 660, 1100, 1200]}
            sizes="(max-width: 700px) min(330px, calc(100vw - 40px)), (min-width: 1440px) 551px, 45vw"
            layout="none"
            alt="Il simbolo della psicologia incontra un albero dai colori rosa e verde"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>
