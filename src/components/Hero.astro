---
import Header from "./Header.astro";
---

<nav>
  <section id="hero" class="h-full overflow-hidden bg-white dark:bg-slate-600">
    <div id="home" class="jumbo max-w-[75rem] mx-auto relative dark:bg-slate-600">
      <div
        class="z-10 pb-8 bg-white dark:bg-slate-600 sm:pb-16 md:pb-20 lg:max-w-2xl lg:w-full lg:pb-28 xl:pb-32">
        <svg
          class="absolute inset-y-0 right-0 hidden w-48 h-full text-white transform translate-x-1/2 lg:block dark:bg-slate-600"
          fill="currentColor"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        ></svg>

        <div>
          <Header />

          <div
            class="px-6 mx-auto animate__animated animate__fadeInLeft mt-14 max-w-7xl sm:mt-12 sm:px-6 md:mt-16 lg:mt-20 lg:px-8 xl:mt-28">
            <div class="sm:text-center lg:text-left">
              <h1 itemscope class="text-4xl font-extrabold tracking-tight text-gray-800 sm:text-5xl md:text-6xl">
                <span class="block text-black title xl:inline dark:text-white">Psicologa Psicoterapeuta</span>
                <span class="block title_2 xl:inline text-sec_color dark:text-pri_color"
                  >Dott.ssa Ilaria Mezzanotti</span
                >
              </h1>
              <p
                class="mt-3 text-base text-gray-500 sm:mt-5 sm:text-lg sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0 dark:text-dark_white">
                Cum lenitate asperitas – Le difficoltà vanno trattate con dolcezza.
              </p>
              <div class="mt-5 sm:mt-8 sm:flex sm:justify-center lg:justify-start">
                <button class="rounded-md shadow">
                  <a
                    title="appuntamenti"
                    target="_blank"
                    rel="noopener noreferrer"
                    itemprop="url"
                    href="https://wa.me/393663712597"
                    class="flex items-center justify-center w-full px-8 py-3 text-base font-medium text-white border border-transparent rounded-lg shadow-xl dark:shadow-3xl md:py-4 md:text-lg md:px-10 bg-pri_color hover:bg-hover_btn dark:bg-sec_color dark:hover:bg-thi_color">
                    Richiedi un appuntamento <i class="ml-2 text-2xl fab fa-whatsapp"></i>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="animate__animated animate__fadeInRight lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
        <img
          class="object-cover w-full lg:w-full lg:h-full dark:hidden rounded-xl"
          title="Ilaria Mezzanotti"
          src="/assets/img/logo.webp"
          width="1790"
          height="1796"
          alt="Dott.ssa Ilaria Mezzanotti, Psicologa e Psicoterapeuta"
        />
        <img
          class="hidden object-cover w-full lg:w-full lg:h-full dark:block rounded-xl dark:invert"
          title="Ilaria Mezzanotti"
          src="/assets/img/dark_logo_.webp"
          width="499"
          height="501"
          alt="Dott.ssa Ilaria Mezzanotti, Psicologa e Psicoterapeuta"
        />
      </div>
    </div>
  </section>
</nav>
