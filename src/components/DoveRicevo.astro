---
---

<section id="dove-ricevo" class="pt-5 mx-4 mt-10 rounded-lg shadow-3xl dark:shadow-3xl bg-pri_color lg:mx-20">
  <div class="container pt-12 pb-12 pl-5 md:text-center">
    <h2 class="text-3xl font-extrabold leading-8 tracking-tight text-white dark:text-slate-500">
      Su appuntamento.
    </h2>
    <span class="pl-5 text-xl font-extrabold leading-8 tracking-tight text-white sm:pl-0 dark:text-slate-500">
      <i class="fa-solid fa-calendar-days" aria-hidden="true"></i> - da Lunedì a Sabato
    </span>
  </div>

  <div class="container flex flex-wrap justify-around pt-12 lg:pb-12">
    <div class="max-w-sm m-4 overflow-hidden rounded-lg shadow-xl animate__animated destra0 dark:shadow-3xl">
      <iframe
        title="Mappa - Studio ReHabilita, Leinì"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2812.362755657613!2d7.716199315371441!3d45.179752579098675!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47886f871528bd13%3A0xbfe6cdd9c1039d72!2sReHabilita%20-%20Studio%20multispecialistico%20di%20Riabilitazione%20e%20Psicologia!5e0!3m2!1sit!2sit!4v1642534410840!5m2!1sit!2sit"
        width="400"
        height="280"
        style="border: 0"
        allowfullscreen
        loading="lazy"></iframe>
      <div class="px-6 py-4 bg-white dark:bg-slate-600" itemprop="address" itemscope>
        <div class="mb-2 text-xl font-bold dark:text-white">
          <i class="far fa-building" aria-hidden="true"></i> Studio ReHabilita
        </div>
        <p class="text-base text-gray-700 dark:text-white" itemprop="locality">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Via Giotto, 10/12, Leinì (TO)
        </p>
      </div>
    </div>
    <div class="max-w-sm m-4 overflow-hidden rounded-lg shadow-xl animate__animated sinistra0 dark:shadow-3xl">
      <iframe
        title="Mappa - Centro Gyanashakti, Robassomero"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2810.8022562407077!2d7.543756415248696!3d45.21133685830174!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47885d4536ed23bb%3A0x4049bdb48640a546!2sCentro%20Discipline%20olistiche%20Gyanashakti!5e0!3m2!1sit!2sit!4v1667053650589!5m2!1sit!2sit"
        width="400"
        height="280"
        style="border: 0"
        allowfullscreen
        loading="lazy"></iframe>
      <div class="px-6 py-4 bg-white dark:bg-slate-600" itemprop="address" itemscope>
        <div class="mb-2 text-xl font-bold dark:text-white">
          <i class="far fa-building" aria-hidden="true"></i> Centro Gyanashakti
        </div>
        <p class="text-base text-gray-700 dark:text-white" itemprop="locality">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Via Lanzo, 41, Robassomero (TO)
        </p>
      </div>
    </div>
  </div>
  <div class="container flex flex-wrap justify-around pb-24">
    <div class="max-w-sm m-4 overflow-hidden rounded-lg shadow-xl animate__animated sinistra0 dark:shadow-3xl">
      <div style="width: 100%">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2801.9646134101768!2d7.650125175796779!3d45.389884638394875!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47888bfbaed9adef%3A0xd5f8d3ca5a3aebf7!2sDott.ssa%20Cristina%20Zucco!5e0!3m2!1sit!2sit!4v1708265228966!5m2!1sit!2sit"
          title="Mappa - Studio Dott.ssa Cristina Zucco, Cuorgnè"
          width="400"
          height="280"
          style="border: 0"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
      <div class="px-6 py-4 bg-white dark:bg-slate-600" itemprop="address" itemscope>
        <div class="mb-2 text-xl font-bold dark:text-white">
          <i class="far fa-building" aria-hidden="true"></i> Studio Dott.ssa Cristina Zucco
        </div>
        <p class="text-base text-gray-700 dark:text-white" itemprop="locality">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Via Torino, 17, Cuorgnè (TO)
        </p>
      </div>
    </div>
  </div>

  <h3 class="pb-10 text-xl text-center text-white dark:text-slate-600">
    <i class="fa-solid fa-wifi" aria-hidden="true"></i> Disponibile Online
  </h3>
</section>
